{
  "name": "duo-workspace",
  "version": "0.6.0",
  "private": true,
  "description": "A shared Windows workspace for Codex and Claude Code",
  "main": "electron/main.cjs",
  "author": "Duo",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "npm run electron:install && npm run build && electron .",
    "electron:install": "node node_modules/electron/install.js",
    "build": "vite build",
    "notices": "node scripts/third-party-notices.cjs",
    "test": "node --test tests/*.test.cjs",
    "test:ui": "node tests/ui-smoke.cjs && node tests/workspaces-smoke.cjs && node tests/files-smoke.cjs && node tests/advanced-smoke.cjs",
    "test:mission": "node tests/mission-smoke.cjs",
    "test:autonomy": "node tests/autonomy-smoke.cjs",
    "test:a11y": "node tests/accessibility-smoke.cjs",
    "test:packaged": "node tests/packaged-smoke.cjs",
    "pack": "npm run electron:install && npm run build && npm run notices && electron-builder --win --dir --publish never",
    "dist": "npm run electron:install && npm run build && npm run notices && electron-builder --win nsis --publish never",
    "test:pilot": "node tests/pilot-smoke.cjs",
    "test:memory": "node tests/personal-memory-smoke.cjs",
    "test:site": "node tests/site-smoke.cjs",
    "site:preview": "node scripts/site-preview.cjs",
    "site:package": "python scripts/package-site.py",
    "check:public": "node scripts/check-public.cjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.14",
    "@fontsource-variable/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "codemirror": "^6.0.2",
    "lucide-react": "^1.54.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.0",
    "axe-core": "^4.11.0",
    "electron": "44.4.1",
    "electron-builder": "^26.0.12",
    "playwright": "^1.58.0",
    "prettier": "3.9.10",
    "vite": "^8.0.0"
  },
  "build": {
    "appId": "local.duo.workspace",
    "productName": "Duo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/@anthropic-ai/claude-agent-sdk-*/**/*"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "skills",
        "filter": [
          "**/*",
          "!**/__pycache__/**"
        ]
      },
      {
        "from": "build/notices",
        "to": "licenses"
      },
      {
        "from": "README.md",
        "to": "README.md"
      },
      {
        "from": "THIRD_PARTY.md",
        "to": "THIRD_PARTY.md"
      },
      {
        "from": "LICENSE",
        "to": "LICENSE"
      },
      {
        "from": "docs",
        "to": "docs"
      },
      {
        "from": "README.fr.md",
        "to": "README.fr.md"
      },
      {
        "from": "website/assets",
        "to": "website/assets",
        "filter": [
          "mission-example.png",
          "BRANDS.txt",
          "codex.svg",
          "claude.svg",
          "github.svg"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kofudev/duo.git"
  },
  "homepage": "https://duo.varelia.fr",
  "bugs": {
    "url": "https://github.com/kofudev/duo/issues"
  },
  "engines": {
    "node": ">=24"
  }
}
